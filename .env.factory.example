# Copy to .env.factory (git-ignored) and fill in. Never commit the filled-in file.

# --- Database (compose.factory-state.yml) ---
FACTORY_DB_ADMIN_PASSWORD=
FACTORY_DB_MIGRATOR_PASSWORD=
FACTORY_DB_RUNTIME_PASSWORD=

# --- Host (Litos.SoftwareFactory.Host) ---
# Used at runtime: least privilege.
ConnectionStrings__FactoryState=Host=127.0.0.1;Port=5433;Database=litos_factory;Username=factory_runtime;Password=<FACTORY_DB_RUNTIME_PASSWORD>
# Used only by `--migrate`.
ConnectionStrings__FactoryMigrations=Host=127.0.0.1;Port=5433;Database=litos_factory;Username=factory_migrator;Password=<FACTORY_DB_MIGRATOR_PASSWORD>

# The one admin account, created on first start (M1 has no invitations).
FACTORY_ADMIN_USER=admin
FACTORY_ADMIN_PASSWORD=

# Where working copies, logs and transcripts live.
FACTORY_DATA_DIR=

# Fine-grained GitHub token with contents and pull-request write access to the registered repositories.
FACTORY_GITHUB_TOKEN=

# OPENROUTER_API_KEY is read from the host's own environment; it is not set here.
