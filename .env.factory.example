# Copy to .env.factory (git-ignored) and fill in. Never commit the filled-in file.

# --- Database (compose.factory-state.yml) ---
FACTORY_DB_ADMIN_PASSWORD=
FACTORY_DB_MIGRATOR_PASSWORD=
FACTORY_DB_RUNTIME_PASSWORD=

# --- Host (Litos.SoftwareFactory.Host) ---
# Used at runtime: least privilege.
ConnectionStrings__FactoryState=Host=127.0.0.1;Port=5433;Database=litos_factory;Username=factory_runtime;Password=<FACTORY_DB_RUNTIME_PASSWORD>
# Used only by `--migrate`.
ConnectionStrings__FactoryMigrations=Host=127.0.0.1;Port=5433;Database=litos_factory;Username=factory_migrator;Password=<FACTORY_DB_MIGRATOR_PASSWORD>

# The one admin account, created on first start (M1 has no invitations).
FACTORY_ADMIN_USER=admin
FACTORY_ADMIN_PASSWORD=

# Where working copies, logs and transcripts live.
FACTORY_DATA_DIR=

# Fine-grained GitHub token with contents and pull-request write access to the registered repositories.
FACTORY_GITHUB_TOKEN=

# OPENROUTER_API_KEY is read from the host's own environment; it is not set here.

# Optional. The token budget a new thread gets when its creator sets none: a number, or "none"
# for no cap. Default 300000.
# FACTORY_DEFAULT_BUDGET=300000

# Optional. How much of an input token read from the provider's prompt cache counts against a
# task's budget, from 0 to 1. An agent resends its conversation on every call, so at 1 a budget
# mostly measures how many calls a task took. Default 0.10.
# FACTORY_CACHED_INPUT_WEIGHT=0.10

# Optional. The share of a task's original cap that each change request after a handoff adds to
# its budget. A change the tester asks for is new work. 0 turns top-ups off. Default 0.5.
# FACTORY_REWORK_TOP_UP=0.5

# Optional. Whether a first run starts with a decision scan that finds the choices the request
# leaves open and asks a person about the ones that need one. On unless set to off.
# FACTORY_DECISION_SCAN=on

# Optional. Stop every first run after its decision scan and report what it would ask and assume,
# without asking or implementing. For checking the scan cheaply on requests. Off by default.
# FACTORY_SCAN_ONLY=off

# Optional. After each answer to a scan question, while questions remain, the scan checks whether
# the answers already settle them before the next is asked. On unless set to off.
# FACTORY_SCAN_RECHECK=on

# Optional. Whether a small change with no risk signal, a clean verification and every criterion
# tested may be handed off without an agent review (the handoff says so). On unless set to off;
# off gives every change at least a light review.
# FACTORY_REVIEW_NONE=on

# Optional. Whether implement, rework and repair turns are told, at set points, what their model
# calls now cost and what fills their context, so they read less and batch more. On unless off.
# FACTORY_COST_NOTES=on

# Optional. The output limit set on, and reserved for, every model call. A reasoning model's
# thinking counts as output, so too small a value leaves no room for the reply. Default 32768.
# FACTORY_OUTPUT_ALLOWANCE=32768

# Optional. How many tasks may run at once, across all repositories; never two on one repository.
# Default 2.
# FACTORY_SLOT_CAP=2

# Optional. How many verification steps (build, tests, coverage) may run at once across all tasks.
# A task whose verify step has to wait says so and continues when one finishes. Tests that bind a
# fixed port can collide when two run at once, which is why the default is 1.
# FACTORY_VERIFY_CONCURRENCY=1

# Optional. The most tokens one chat answer may use. A message without @factory is answered by a
# read-only chat turn, which is not charged to the task's budget; this caps each answer instead.
# FACTORY_CHAT_TURN_CAP=100000
