<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Litos.Host\Litos.Host.csproj" />
    <ProjectReference Include="..\Litos.Tools.Mcp\Litos.Tools.Mcp.csproj" />
  </ItemGroup>

  <!--
    examples/ holds standalone example projects (their own .csproj files) that demonstrate
    calling Litos.Api over HTTP — they are siblings of this project in directory terms only, not
    part of it. Without these excludes, Microsoft.NET.Sdk.Web's default globs would recursively
    pull every example's .cs/.razor files into *this* assembly too, alongside their own build.
  -->
  <ItemGroup>
    <Compile Remove="examples\**" />
    <Content Remove="examples\**" />
    <None Remove="examples\**" />
    <EmbeddedResource Remove="examples\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Litos.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenAI" Version="2.12.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Telegram.Bot" Version="22.10.2.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Explicit pins, not left to float to whatever Npgsql.EntityFrameworkCore.PostgreSQL
         10.0.3 transitively resolves (10.0.4) — keeps every EF Core assembly in this project at
         the same 10.0.11 version as Microsoft.EntityFrameworkCore.Design above, avoiding an
         MSB3277 conflict for any downstream project (e.g. Litos.Api.Tests) that also references
         a 10.0.11 EF Core package directly. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
