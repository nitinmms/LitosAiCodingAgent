# Copy to .env (git-ignored) and fill in real values, then:
#   docker run --env-file src/Litos.Api/.env -p 127.0.0.1:8080:8080 \
#     -v ~/litos-workspace:/workspace -v ~/.litos-docker:/data litos-api:dev
#
# Names must match LitosConfig.cs's EnvVarNames exactly. Env var always wins over
# any value in the mounted /data/.litos/config.json.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY= is accepted as a fallback for GEMINI_API_KEY
OPENROUTER_API_KEY=
TAVILY_API_KEY=

# Admin UI token (Bearer/cookie) — see ReadMe_HeadlessServiceTool.md §5.5. Still works
# post-per-user-accounts as a bootstrap/superuser credential (maps to SessionOwner.Local).
ADMIN_TOKEN=

# Postgres 18 connection string for per-user accounts (username/password login, Data/UserStore.cs).
# Not needed if you run via `docker compose up` at the repo root — docker-compose.yml sets this
# for you, pointed at its own postgres sidecar service.
POSTGRES_CONNECTION_STRING=

# HMAC-SHA256 signing key for per-user API access tokens (POST /auth/token, Auth/JwtTokenService.cs).
# Non-admin ("client") accounts are blocked from the Blazor UI's cookie login entirely — this is
# their only way to authenticate. Must be at least 32 random bytes; generate with e.g.
# `openssl rand -base64 32`. Rotating this invalidates every outstanding access/refresh token.
JWT_SIGNING_KEY=

# Bot token from @BotFather — enables the Telegram bridge (Settings page also accepts this,
# but env var always wins). Bridge still starts OFF by default; toggle it from /telegram.
TELEGRAM_BOT_TOKEN=
