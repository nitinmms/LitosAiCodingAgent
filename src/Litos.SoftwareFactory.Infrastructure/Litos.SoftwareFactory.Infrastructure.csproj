<Project Sdk="Microsoft.NET.Sdk">

  <!-- The software factory's side effects: the git CLI, the GitHub REST API, running
       verification profiles and reading their reports, and launching worker processes
       (docs/software-factory/m1-architecture.md §5). The EF Core store joins with the host. -->
  <ItemGroup>
    <ProjectReference Include="..\Litos.SoftwareFactory.Core\Litos.SoftwareFactory.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Verification\Presets\*.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Litos.SoftwareFactory.Infrastructure.Tests" />
  </ItemGroup>

</Project>
