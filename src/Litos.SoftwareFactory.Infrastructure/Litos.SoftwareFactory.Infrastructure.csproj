<Project Sdk="Microsoft.NET.Sdk">

  <!-- The software factory's side effects: the git CLI, the GitHub REST API, running
       verification profiles and reading their reports, and launching worker processes
       (docs/software-factory/m1-architecture.md §5). The EF Core store joins with the host. -->
  <ItemGroup>
    <ProjectReference Include="..\Litos.SoftwareFactory.Core\Litos.SoftwareFactory.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.9" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Verification\Presets\*.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Litos.SoftwareFactory.Infrastructure.Tests" />
  </ItemGroup>

</Project>
