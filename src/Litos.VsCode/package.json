{
  "name": "litos-vscode",
  "displayName": "Litos",
  "description": "Chat with the Litos AI coding agent inside VS Code.",
  "version": "0.1.0",
  "publisher": "litos",
  "icon": "media/icon.png",
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/nitinmms/LitosAiCodingAgent.git",
    "directory": "src/Litos.VsCode"
  },
  "bugs": {
    "url": "https://github.com/nitinmms/LitosAiCodingAgent/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "litos",
          "title": "Litos",
          "icon": "media/litos-mark-v2.svg"
        }
      ]
    },
    "views": {
      "litos": [
        {
          "id": "litos.chatView",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "litos.openChat",
        "title": "Open Litos",
        "icon": "media/icon.png"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "litos.openChat",
          "when": "view == litos.chatView",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "litos.openChat",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
