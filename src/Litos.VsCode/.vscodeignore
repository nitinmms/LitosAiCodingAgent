# Source and dev-only files — dist/ (tsc output) is what actually ships.
src/**
.vscode/**
**/__tests__/**
**/*.map
**/*.test.ts

# Dev tooling / lockfiles / config, not needed at runtime.
node_modules/**
package-lock.json
tsconfig.json
.gitignore
.vscodeignore
.vscodeignore.*.generated

# Publish-directory noise that isn't a shipped binary. Covers both bundled executables —
# Litos.VsCodeHost and the Programmatic Tool Calling kernel, Litos.Kernel.Host — since each RID
# folder holds the two side by side (that adjacency is how the host locates the kernel).
bin/**/*.pdb
bin/**/web.config
bin/**/*.staticwebassets.endpoints.json

# vsce packages per-platform via --target; each targeted RID folder is excluded except the one
# matching that target via the corresponding vsce package invocation (see deploy tooling).
