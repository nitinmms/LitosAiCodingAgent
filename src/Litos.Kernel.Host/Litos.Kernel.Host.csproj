<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Wire protocol only, NOT Litos.Kernel: referencing the parent-side assembly here would drag
         in Litos.Agent + Litos.Tools.Mcp (and transitively all of Litos.Tools — SkiaSharp, pdfium,
         OpenXml, BouncyCastle, PdfPig, AWS SDK, MimeKit) that no code path in this subprocess can
         reach, since the real tools are invoked on the PARENT side of the bridge. See
         Litos.Kernel.Wire.csproj's own comment. -->
    <ProjectReference Include="..\Litos.Kernel.Wire\Litos.Kernel.Wire.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.14.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Self-contained, single-file publish per-RID, mirroring Litos.VsCodeHost.csproj — this
    subprocess must ship for both Windows and macOS (ReadMe_PTCPersistentKernel.md §2's Hard
    requirements), not just whatever platform it happens to be built on.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>None</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('osx-'))">
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
