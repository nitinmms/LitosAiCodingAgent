<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Litos.Host\Litos.Host.csproj" />
    <ProjectReference Include="..\Litos.Tools.Mcp\Litos.Tools.Mcp.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- dotnet publish -c Release -r (win-x64|osx-x64|osx-arm64|linux-x64|linux-arm64), self-contained,
       single-file. Same pattern as Litos.Console.csproj — bundled into the VS Code extension's
       .vsix per-RID so end users need no separate .NET install (see ReadMe_VsCodeExtension.md). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No .pdb output: this binary is bundled straight into the VS Code extension's own bin/<rid>/
         folder (see ReadMe_VsCodeExtension.md §10.2), unlike Litos.Console which publishes to a
         separate deploy/out/ dir — a stray .pdb here would otherwise ship inside the .vsix. -->
    <DebugType>None</DebugType>
  </PropertyGroup>

  <!-- macOS-only override: a compressed single-file bundle extracts its native libraries (incl.
       CoreCLR itself) to a temp directory and loads them from there at startup. Under the hardened
       runtime notarization requires ("codesign -\-options runtime"), the kernel's code-signing
       enforcement blocks loading those extracted-at-runtime dylibs, so CoreCLR bootstrap fails with
       "Failed to create CoreCLR, HRESULT: 0x80070008" — confirmed live on a real signed/notarized
       osx-arm64 build. Disabling compression lets the OS load native libraries straight out of the
       signed single-file bundle with no runtime extraction step. Windows is unaffected (no hardened
       runtime / code-signing enforcement of this kind), so this is scoped to osx-* RIDs only. -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('osx-'))">
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
