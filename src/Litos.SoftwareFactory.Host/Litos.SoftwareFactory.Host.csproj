<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The software factory's host (ReadMe_LitosSoftwareFactory_V1.md §13): the API and event
       stream the browser talks to, sign-in, the model gateway, and the coordinator that drives
       runs. Standalone: nothing here references Litos.Api, and Litos.Host is referenced only for
       the real chat providers behind the gateway. -->
  <ItemGroup>
    <ProjectReference Include="..\Litos.SoftwareFactory.Core\Litos.SoftwareFactory.Core.csproj" />
    <ProjectReference Include="..\Litos.SoftwareFactory.Infrastructure\Litos.SoftwareFactory.Infrastructure.csproj" />
    <ProjectReference Include="..\Litos.SoftwareFactory.Contracts\Litos.SoftwareFactory.Contracts.csproj" />
    <ProjectReference Include="..\Litos.Artifacts\Litos.Artifacts.csproj" />
    <ProjectReference Include="..\Litos.Host\Litos.Host.csproj" />
    <ProjectReference Include="..\Litos.Tools.Mcp\Litos.Tools.Mcp.csproj" />
    <!-- The browser checks before handoff (README_Litos.Probe.Web.md §2): an in-host library. -->
    <ProjectReference Include="..\Litos.Probe.Web\Litos.Probe.Web.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Litos.SoftwareFactory.Host.Tests" />
  </ItemGroup>

  <!-- The host serves the web app from beside its binary (FactoryHostApp: content root), so the
       React build in wwwroot is copied there on build, as publishing already does. -->
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Playwright's Node driver must stay a real folder beside the executable: a single-file
       publish with IncludeNativeLibrariesForSelfExtract otherwise bundles node.exe into the host,
       where Playwright can't start it (deploy/publish-factory-windows.ps1). -->
  <Target Name="KeepPlaywrightDriverOutOfSingleFile" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('.playwright'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
