<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Litos.Gui"
             x:Class="Litos.Gui.MentionPopup"
             Width="360">
  <ListBox Name="ItemsList" MaxHeight="280" Background="Transparent">
    <ListBox.ItemTemplate>
      <DataTemplate x:DataType="local:MentionPopup+MentionEntry">
        <Grid ColumnDefinitions="20,*" Margin="4,2">
          <TextBlock Grid.Column="0" Text="{Binding Icon}" />
          <TextBlock Grid.Column="1" Text="{Binding Path}" Foreground="WhiteSmoke" Margin="6,0,0,0" TextWrapping="Wrap" />
        </Grid>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</UserControl>
