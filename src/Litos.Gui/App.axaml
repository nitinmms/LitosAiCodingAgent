<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Litos.Gui.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <!-- MarkView.Avalonia ships its own default styling for rendered markdown (links, tables,
         images, etc. — see Themes/MarkdownTheme.axaml) but does not merge it in automatically;
         a consuming app is expected to include it explicitly, the same convention FluentTheme
         itself follows. Without this, MarkdownHyperlink.markdown-link (and every other built-in
         markdown-* class) has no styling at all, which is why links previously rendered as plain
         white text with no underline despite being genuinely clickable. -->
    <StyleInclude Source="avares://MarkView.Avalonia/Themes/MarkdownTheme.axaml" />
    <Style Selector="Border.markdown-code-block">
      <Setter Property="Background" Value="#151515" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style Selector="Border.markdown-code-block TextBlock">
      <Setter Property="FontFamily" Value="Cascadia Code,Consolas,monospace" />
      <Setter Property="Foreground" Value="#D4D4D4" />
    </Style>
    <Style Selector="Border.markdown-code-inline">
      <Setter Property="Background" Value="#2A2A2A" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="4,1" />
    </Style>
    <Style Selector="Border.markdown-code-inline TextBlock">
      <Setter Property="FontFamily" Value="Cascadia Code,Consolas,monospace" />
      <Setter Property="Foreground" Value="#CE9178" />
    </Style>
  </Application.Styles>
</Application>
