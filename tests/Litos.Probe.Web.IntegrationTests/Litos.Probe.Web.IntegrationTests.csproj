<Project Sdk="Microsoft.NET.Sdk">

  <!-- Litos.Probe.Web against real Chromium and real app processes (README_Litos.Probe.Web.md §3):
       the test apps under ../Litos.Probe.Web.TestApps, built and started through their contracts.
       Tests skip, rather than fail, on a machine without Chromium for Playwright, node or npm. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Litos.Probe.Web\Litos.Probe.Web.csproj" />
  </ItemGroup>

</Project>
