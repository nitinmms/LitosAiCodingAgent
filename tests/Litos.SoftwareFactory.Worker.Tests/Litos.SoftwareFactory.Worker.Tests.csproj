<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Litos.Kernel.Host is referenced so the kernel subprocess is built beside the tests: the
       completion tools are exercised through a real kernel, the way a PTC run calls them. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Litos.SoftwareFactory.Worker\Litos.SoftwareFactory.Worker.csproj" />
    <ProjectReference Include="..\..\src\Litos.Kernel.Host\Litos.Kernel.Host.csproj" />
  </ItemGroup>

</Project>
