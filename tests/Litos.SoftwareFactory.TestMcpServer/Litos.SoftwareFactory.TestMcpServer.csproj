<Project Sdk="Microsoft.NET.Sdk">

  <!-- A stdio MCP server for the factory's tests: the worker and Test connection start it as a
       real process, as they would any configured server. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The shared framework, as the test projects that copy this server beside them have, so its
       hosting assemblies resolve the same way in their output folders. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.0.0" />
  </ItemGroup>

</Project>
