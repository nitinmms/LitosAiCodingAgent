<!--
  Litos Factory Tray for Windows, on its own (ReadMe_LitosSoftwareFactory_V1.md §26.3): for people
  whose factory runs on a server, or on someone else's PC. It installs only litos-factory-tray.exe:
  no Docker, database or host. The factory's own MSI installs the same program beside the factory.

    install, repair, upgrade   litos-factory-tray, option register   (start at sign-in, unless turned off)
                               litos-factory-tray, option background (after the install: in the tray now)
    before files change        litos-factory-tray, option quit       (a running tray app locks its file)
    uninstall                  litos-factory-tray, option unregister

  Finish offers "Connect it to your factory now", which opens its Settings. Its settings and token
  (Credential Manager) are kept on uninstall.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Litos Factory Tray"
           Manufacturer="Litos"
           Version="$(ProductVersion)"
           UpgradeCode="7328B880-805F-428C-B2DF-DACA1E8AAFFD"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Litos Factory Tray is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="TrayIcon" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="TrayIcon" />

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Connect it to your factory now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="OpenTraySettings"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT REMOVE" />
    </UI>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="LitosFactoryTray" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="TrayFiles" Directory="INSTALLFOLDER">
      <Component Id="TrayProgram" Guid="E0101079-874E-48B3-BACE-6ED54624E112">
        <File Id="TrayExe" Source="$(PublishDir)\litos-factory-tray.exe" />
        <RegistryValue Root="HKCU" Key="Software\Litos\FactoryTray" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RemoveFolder Id="RemoveUserProgramsFolder" Directory="UserProgramsFolder" On="uninstall" />
      </Component>
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="B0AF171F-949A-41A5-ABE5-64D546766C39">
        <!-- Starts the tray app; when it already runs, opens its Settings. -->
        <Shortcut Id="TrayShortcut" Name="Litos Factory Tray"
                  Description="Rings when one of your tasks starts waiting on you"
                  Target="[INSTALLFOLDER]litos-factory-tray.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="TrayIcon" />
        <RegistryValue Root="HKCU" Key="Software\Litos\FactoryTray" Name="Shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Tray" Title="Litos Factory Tray" Level="1">
      <ComponentGroupRef Id="TrayFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <CustomAction Id="QuitTray" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]litos-factory-tray.exe&quot; --quit"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <CustomAction Id="UnregisterTray" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]litos-factory-tray.exe&quot; --unregister"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <CustomAction Id="RegisterTray" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]litos-factory-tray.exe&quot; --register"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <CustomAction Id="StartTray" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]litos-factory-tray.exe&quot; --background"
                  Execute="immediate" Impersonate="yes" Return="asyncNoWait" />
    <CustomAction Id="OpenTraySettings" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]litos-factory-tray.exe&quot; --settings"
                  Execute="immediate" Impersonate="yes" Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="QuitTray" Before="RemoveFiles" Condition="Installed" />
      <!-- Not when an upgrade removes the old version: the start at sign-in stays. -->
      <Custom Action="UnregisterTray" After="QuitTray" Condition="REMOVE ~= &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RegisterTray" After="InstallFiles" Condition="NOT REMOVE ~= &quot;ALL&quot;" />
      <Custom Action="StartTray" After="InstallFinalize" Condition="NOT REMOVE ~= &quot;ALL&quot;" />
    </InstallExecuteSequence>

  </Package>
</Wix>
